{
  "name": "netschool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "biome check .",
    "meshcentral:install": "cd infra/meshcentral/upstream && npm ci --omit=optional --no-audit --no-fund",
    "meshcentral:agents": "node infra/meshcentral/upstream/agents/check-releases.js --output infra/meshcentral/agent-cache",
    "build:api": "pnpm --filter @netschool/api build",
    "build:web": "pnpm --filter @netschool/web build",
    "build:helper": "node scripts/build-helper.mjs",
    "test:helper": "cd native/helper && go vet ./... && go test ./...",
    "test:e2e:companion": "NETSCHOOL_COMPANION_TEST_BUILD=1 pnpm --filter @netschool/companion build && vitest run --project companion-e2e",
    "test:e2e:web": "pnpm --filter @netschool/web build && vitest run --project web-e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
