# compose.yaml uchun: `cp .env.example .env` va qiymatlarni o'zgartiring. Bu faylda sir yo'q.
PUBLIC_ORIGIN=https://hub.school.lan
# Remote session gateway (viewer) origin'i: xuddi shu host, 8444 port.
GATEWAY_PUBLIC_ORIGIN=https://hub.school.lan:8444
# Ichki Docker tarmog'i (ixtiyoriy; standart qiymatlar). Maktab LAN'i bilan to'qnashsa uchalasini birga almashtiring:
# API_IP subnet ichida, lekin HUB_DYNAMIC_RANGE dan tashqarida bo'lsin. MeshCentral X-Forwarded-For'ni faqat API_IP'dan ishonadi.
# HUB_SUBNET=172.31.250.0/24
# HUB_DYNAMIC_RANGE=172.31.250.128/25
# API_IP=172.31.250.10
