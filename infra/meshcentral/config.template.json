{
  "settings": {
    "trustedProxy": "127.0.0.1",
    "desktopMultiplex": false,
    "webRTC": false,
    "allowLoginToken": false,
    "allowFraming": false,
    "cookieIpCheck": "strict",
    "maxInvalidLogin": {
      "time": 10,
      "count": 10,
      "coolofftime": 10,
      "blocking": "ip",
      "exclude": "127.0.0.1,::1"
    }
  },
  "domains": {
    "": {
      "newAccounts": false,
      "passwordRequirements": {
        "min": 16,
        "max": 128,
        "upper": 1,
        "lower": 1,
        "numeric": 1,
        "nonalpha": 1,
        "loginTokens": false
      }
    }
  }
}
